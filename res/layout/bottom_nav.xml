<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navBar"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="5dp"
    android:elevation="10dp"
    android:outlineProvider="background"
    android:tag="nav">

    <TextView
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/ic_nav_home"
        android:drawablePadding="4dp"
        android:text="@string/nav_home"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/navTrack"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/ic_nav_track"
        android:drawablePadding="4dp"
        android:text="@string/nav_track"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/navHistory"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/ic_nav_history"
        android:drawablePadding="4dp"
        android:text="@string/nav_history"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/ic_nav_settings"
        android:drawablePadding="4dp"
        android:text="@string/nav_settings"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
