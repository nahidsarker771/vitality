<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_bg_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFF4F6FF"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/wTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8A93A8"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wOverall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFF4F6FF"
        android:textSize="42sp"
        android:fontFamily="sans-serif-light" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/today_power"
        android:textColor="#FF8A93A8"
        android:textSize="9sp"
        android:letterSpacing="0.18" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="2dp"
        android:background="#22808080" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wWillLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/willpower"
            android:textColor="#FF8A93A8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wWillPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4F6FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wWillBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_bar_will" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wWealthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wealth_power"
            android:textColor="#FF8A93A8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wWealthPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4F6FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wWealthBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_bar_wealth" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wEnergyLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/energy_power"
            android:textColor="#FF8A93A8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wEnergyPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4F6FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wEnergyBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_bar_energy" />

    <TextView
        android:id="@+id/wReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:text="@string/widget_resets"
        android:textColor="#FF8A93A8"
        android:textSize="9sp" />
</LinearLayout>
